<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Kalkulator Punktów</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@700;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#f0ede8;--card:#fff;--text:#1e1a17;--muted:#7a7068;--border:#ddd8d0;--accent:#e8553d;--accent-soft:#fef0ed;--green:#2d8a56;--green-soft:#edf7f0;--blue:#3068b8;--blue-soft:#edf2fb;--yellow:#b06a00;--yellow-soft:#fef3e2;--shadow:0 1px 4px rgba(30,26,23,.07),0 4px 16px rgba(30,26,23,.05)}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);padding-bottom:6rem}
.topbar{position:sticky;top:0;z-index:100;background:var(--text);color:#fff;padding:.85rem 1rem;display:flex;align-items:center;gap:12px;box-shadow:0 2px 12px rgba(0,0,0,.2)}
.topbar-title{font-family:'Outfit',sans-serif;font-weight:800;font-size:1rem;flex:1}
.topbar-pts{font-family:'Outfit',sans-serif;font-weight:900;font-size:1.5rem;color:var(--accent);letter-spacing:-.02em}
.topbar-sub{font-size:.72rem;opacity:.6;text-align:right;line-height:1.3}
.container{max-width:480px;margin:0 auto;padding:.75rem .85rem 0}
.day-card{background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:.75rem;box-shadow:var(--shadow);overflow:hidden}
.day-header{display:flex;align-items:center;gap:10px;padding:.75rem 1rem;cursor:pointer;border-bottom:1px solid transparent;transition:border-color .2s}
.day-card.has-data .day-header{border-bottom-color:var(--border)}
.day-dot{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Outfit',sans-serif;font-weight:800;font-size:.8rem;flex-shrink:0}
.day-dot.empty{background:var(--bg);color:var(--muted)}
.day-dot.run{background:var(--accent);color:#fff}
.day-dot.dist{background:var(--blue);color:#fff}
.day-dot.time{background:var(--green);color:#fff}
.day-dot.mixed{background:var(--text);color:#fff}
.day-name{font-weight:700;font-size:.9rem;flex:1}
.day-pts{font-family:'Outfit',sans-serif;font-weight:800;font-size:1.1rem;color:var(--accent)}
.day-pts.zero{color:var(--muted);font-weight:500;font-size:.82rem}
.day-body{padding:.75rem 1rem}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:.65rem}
.chip{display:flex;align-items:center;gap:5px;padding:4px 10px 4px 8px;border-radius:20px;font-size:.78rem;font-weight:500;border:1px solid}
.chip-run{background:var(--accent-soft);color:var(--accent);border-color:#f5c5bb}
.chip-dist{background:var(--blue-soft);color:var(--blue);border-color:#b8cfef}
.chip-time{background:var(--green-soft);color:var(--green);border-color:#b8ddc3}
.chip-del{width:16px;height:16px;border-radius:50%;background:currentColor;opacity:.25;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:10px;font-style:normal;flex-shrink:0;transition:opacity .15s}
.chip-del:hover{opacity:.5}
.day-calc{background:var(--bg);border-radius:8px;padding:.55rem .75rem;margin-bottom:.65rem;font-size:.78rem;line-height:1.8;color:var(--muted)}
.day-calc strong{color:var(--text)}
.add-btns{display:flex;gap:6px;flex-wrap:wrap}
.add-btn{flex:1;min-width:80px;padding:.5rem .4rem;border-radius:9px;border:1.5px dashed var(--border);background:transparent;font-family:'DM Sans',sans-serif;font-size:.75rem;font-weight:600;color:var(--muted);cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:3px}
.add-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}
.add-btn.blue:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-soft)}
.add-btn.green:hover{border-color:var(--green);color:var(--green);background:var(--green-soft)}
.add-btn:disabled{opacity:.35;cursor:not-allowed;border-color:var(--border);color:var(--muted);background:transparent}
.inline-form{background:var(--bg);border-radius:10px;padding:.75rem .85rem;margin-top:.6rem;border:1px solid var(--border)}
.form-title{font-size:.78rem;font-weight:700;margin-bottom:.55rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.form-row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}
.form-group{display:flex;flex-direction:column;gap:4px;flex:1;min-width:80px}
.form-group label{font-size:.72rem;font-weight:600;color:var(--muted)}
.form-group input,.form-group select{padding:.45rem .6rem;border:1.5px solid var(--border);border-radius:8px;font-family:'DM Sans',sans-serif;font-size:.85rem;background:var(--card);color:var(--text);outline:none;transition:border-color .15s}
.form-group input:focus,.form-group select:focus{border-color:var(--accent)}
.form-btns{display:flex;gap:6px;margin-top:.55rem}
.btn-confirm{flex:1;padding:.5rem;border-radius:8px;border:none;background:var(--accent);color:#fff;font-family:'DM Sans',sans-serif;font-size:.83rem;font-weight:700;cursor:pointer}
.btn-cancel{padding:.5rem .75rem;border-radius:8px;border:1.5px solid var(--border);background:transparent;font-family:'DM Sans',sans-serif;font-size:.83rem;color:var(--muted);cursor:pointer}
.preview{font-size:.78rem;color:var(--muted);margin-top:.4rem;min-height:1.2em}
.week-summary{background:var(--card);border:1px solid var(--border);border-radius:14px;margin-top:.25rem;box-shadow:var(--shadow);overflow:hidden}
.week-header{background:var(--text);color:#fff;padding:.75rem 1rem;font-family:'Outfit',sans-serif;font-weight:800;font-size:1rem}
.week-body{padding:.85rem 1rem}
.week-row{display:flex;justify-content:space-between;align-items:center;padding:.35rem 0;border-bottom:1px solid var(--border);font-size:.84rem}
.week-row:last-child{border-bottom:none}
.week-row.total{font-weight:700;font-size:1rem;padding-top:.6rem;margin-top:.1rem;border-top:2px solid var(--border);border-bottom:none}
.pts-r{color:var(--accent);font-weight:600}
.pts-g{color:var(--green);font-weight:600}
.pts-b{color:var(--blue);font-weight:600}
.pts-total{font-family:'Outfit',sans-serif;font-weight:900;font-size:1.3rem;color:var(--accent)}
.reset-btn{display:block;width:100%;padding:.65rem;margin-top:.75rem;border-radius:10px;border:1.5px solid var(--border);background:transparent;font-family:'DM Sans',sans-serif;font-size:.83rem;font-weight:600;color:var(--muted);cursor:pointer}
.reset-btn:hover{border-color:#e04040;color:#e04040}
.progress-row{display:flex;gap:4px;margin:.55rem 0}
.progress-dot{flex:1;height:5px;border-radius:3px;background:var(--border);transition:background .3s}
.progress-dot.run{background:var(--accent)}
.progress-dot.dist{background:var(--blue)}
.progress-dot.time{background:var(--green)}
.progress-dot.mixed{background:var(--text)}
</style>
</head>
<body>
<div class="topbar">
  <div>
    <div class="topbar-title">🏃 Kalkulator punktów</div>
    <div id="topSub" class="topbar-sub">0 aktywnych dni</div>
  </div>
  <div>
    <div class="topbar-pts" id="topPts">0</div>
    <div class="topbar-sub">pkt / tydz.</div>
  </div>
</div>
<div class="container" id="app"></div>

<script>
const DAYS_FULL=['Poniedziałek','Wtorek','Środa','Czwartek','Piątek','Sobota','Niedziela'];
const DAYS_SHORT=['Pon','Wt','Śr','Czw','Pt','Sob','Nd'];

// Distance activities (km-based, use multiplier)
const DIST_TYPES=[
  {v:'walk', l:'🚶 Spacer/marsz', mult:0.5, unit:'km'},
  {v:'bike', l:'🚴 Rower',        mult:0.2, unit:'km'},
  {v:'swim', l:'🏊 Pływanie',     mult:5.0, unit:'km'},
];
// Time activities (duration-based)
const TIME_TYPES=[
  {v:'gym',   l:'🏋️ Siłownia/ćwiczenia'},
  {v:'yoga',  l:'🧘 Joga/Pilates'},
  {v:'dance', l:'💃 Taniec/Aerobik'},
  {v:'fight', l:'⚔️ Walki/Sporty walki'},
  {v:'other', l:'💪 Inne'},
];
const DIST_LABELS={walk:'Spacer',bike:'Rower',swim:'Pływanie'};
const TIME_LABELS={gym:'Siłownia',yoga:'Joga/Pilates',dance:'Taniec',fight:'Walki',other:'Trening'};

let state={days:Array(7).fill(null).map(()=>({runs:[],distActs:[],timeActs:[]}))};
try{const s=localStorage.getItem('kalk_v3');if(s)state=JSON.parse(s);while(state.days.length<7)state.days.push({runs:[],distActs:[],timeActs:[]});}catch(e){}

function save(){try{localStorage.setItem('kalk_v3',JSON.stringify(state));}catch(e){}}

// ── SCORING ──
function distPts(type, km){
  const dt=DIST_TYPES.find(d=>d.v===type);
  if(!dt||km<=0)return 0;
  return Math.round((dt.mult*km*5)*10)/10;
}
function timePts(dur){
  if(dur<20)return 0;
  if(dur<=40)return 20;
  if(dur<=60)return 30;
  if(dur<=90)return 40;
  return 50;
}
function calcDay(d, timeBudget){
  if(timeBudget===undefined||timeBudget===null) timeBudget=Infinity;
  const validRuns=d.runs.filter(r=>r.km>=3);
  const hasRun=validRuns.length>0;
  const runKm=validRuns.reduce((s,r)=>s+r.km,0);
  const runKmPts=Math.round(runKm*5*10)/10;

  const validDists=(d.distActs||[]).filter(a=>a.type==='walk'?a.km>=3:a.km>0);
  const distPtsTotal=Math.round(validDists.reduce((s,a)=>s+a.km*distMult(a.type)*5,0)*10)/10;
  const hasDistAct=validDists.length>0;

  const allTimeActs=d.timeActs.filter(a=>a.dur>=20);
  const validTimeActs=allTimeActs.slice(0, Math.max(0,timeBudget));
  const hasTimeAct=validTimeActs.length>0;
  const timePtsTotal=validTimeActs.reduce((s,a)=>s+timePts(a.dur),0);
  const timeActsUsed=validTimeActs.length;

  const hasAny=hasRun||hasDistAct||hasTimeAct;
  if(!hasAny)return{pts:0,hasRun,hasDistAct,hasTimeAct,runKm,runKmPts,distPtsTotal,timePtsTotal,timeActsUsed:0};

  // Bonus +20 zawsze raz dziennie + punkty za każdą aktywność osobno
  let pts=20;
  if(hasRun)pts+=runKmPts;
  if(hasDistAct)pts+=distPtsTotal;
  if(hasTimeAct)pts+=timePtsTotal;

  return{pts:Math.round(pts*10)/10,hasRun,hasDistAct,hasTimeAct,runKm,runKmPts,distPtsTotal,timePtsTotal,timeActsUsed};
}

function calcWeek(){
  // Limit 4 aktywności czasowych tygodniowo — liczone chronologicznie
  let timeUsed=0;
  const days=state.days.map(d=>{
    const budget=Math.max(0,4-timeUsed);
    const dc=calcDay(d,budget);
    timeUsed+=dc.timeActsUsed;
    return dc;
  });
  const activeDays=days.filter(d=>d.pts>0).length;
  const runDays=days.filter(d=>d.hasRun).length;
  const timeActCount=state.days.reduce((s,d)=>s+d.timeActs.filter(a=>a.dur>=20).length,0);
  const dailyTotal=days.reduce((s,d)=>s+d.pts,0);
  let regBonus=activeDays>=5?60:activeDays>=4?40:activeDays>=3?20:0;
  let runBonus=runDays>=4?50:runDays>=3?25:runDays>=2?10:0;
  return{days,activeDays,runDays,timeActCount,dailyTotal,regBonus,runBonus,total:Math.round(dailyTotal+regBonus+runBonus)};
}

let openForm=null;

function render(){
  const w=calcWeek();
  const app=document.getElementById('app');
  app.innerHTML='';

  const prog=document.createElement('div');
  prog.className='progress-row';
  w.days.forEach(d=>{
    const dot=document.createElement('div');
    const cls=d.hasRun&&(d.hasDistAct||d.hasTimeAct)?'mixed':d.hasRun?'run':d.hasDistAct?'dist':d.pts>0?'time':'';
    dot.className='progress-dot'+(cls?' '+cls:'');
    prog.appendChild(dot);
  });
  app.appendChild(prog);

  state.days.forEach((dayData,idx)=>{
    app.appendChild(buildDayCard(dayData,idx,w.days[idx],w.timeActCount));
  });
  app.appendChild(buildWeekSummary(w));

  const rb=document.createElement('button');
  rb.className='reset-btn';rb.textContent='🗑 Wyczyść cały tydzień';
  rb.onclick=()=>{if(confirm('Wyczyścić tydzień?')){state.days=Array(7).fill(null).map(()=>({runs:[],distActs:[],timeActs:[]}));openForm=null;save();render();}};
  app.appendChild(rb);

  document.getElementById('topPts').textContent=w.total;
  document.getElementById('topSub').textContent=`${w.activeDays} aktywnych dni · ${w.runDays} biegowych`;
}

function buildDayCard(dayData,idx,dc,totalTimeActs){
  const card=document.createElement('div');
  card.className='day-card'+(dc.pts>0?' has-data':'');

  const hdr=document.createElement('div');hdr.className='day-header';
  const dotCls=dc.hasRun&&(dc.hasDistAct||dc.hasTimeAct)?'mixed':dc.hasRun?'run':dc.hasDistAct?'dist':dc.pts>0?'time':'empty';
  hdr.innerHTML=`<div class="day-dot ${dotCls}">${DAYS_SHORT[idx]}</div><div class="day-name">${DAYS_FULL[idx]}</div><div class="day-pts${dc.pts===0?' zero':''}">${dc.pts===0?'—':Math.round(dc.pts)+' pkt'}</div>`;
  card.appendChild(hdr);

  const hasOpenForm=openForm&&openForm.dayIdx===idx;
  if(dc.pts>0||hasOpenForm){
    const body=document.createElement('div');body.className='day-body';

    // Chips
    const chips=document.createElement('div');chips.className='chips';
    dayData.runs.forEach((r,ri)=>{
      if(r.km<3)return;
      const c=document.createElement('div');c.className='chip chip-run';
      c.innerHTML=`🏃 ${r.km} km`;
      const del=document.createElement('i');del.className='chip-del';del.textContent='×';
      del.onclick=()=>{dayData.runs.splice(ri,1);save();render();};
      c.appendChild(del);chips.appendChild(c);
    });
    dayData.distActs.forEach((a,ai)=>{
      const c=document.createElement('div');c.className='chip chip-dist';
      c.innerHTML=`${a.type==='walk'?'🚶':a.type==='bike'?'🚴':'🏊'} ${DIST_LABELS[a.type]||a.type} ${a.km} km`;
      const del=document.createElement('i');del.className='chip-del';del.textContent='×';
      del.onclick=()=>{dayData.distActs.splice(ai,1);save();render();};
      c.appendChild(del);chips.appendChild(c);
    });
    dayData.timeActs.forEach((a,ai)=>{
      if(a.dur<20)return;
      const c=document.createElement('div');c.className='chip chip-time';
      c.innerHTML=`💪 ${TIME_LABELS[a.type]||a.type} ${a.dur} min`;
      const del=document.createElement('i');del.className='chip-del';del.textContent='×';
      del.onclick=()=>{dayData.timeActs.splice(ai,1);save();render();};
      c.appendChild(del);chips.appendChild(c);
    });
    if(chips.children.length)body.appendChild(chips);

    // Breakdown
    if(dc.pts>0){
      const calc=document.createElement('div');calc.className='day-calc';
      let parts=[];
      if(dc.hasRun||dc.hasDistAct)parts.push('<strong>+20</strong> bonus dzienny');
      if(dc.runKmPts>0)parts.push(`<strong>+${dc.runKmPts}</strong> (${dc.runKm} km bieg)`);
      if(dc.distPtsTotal>0)parts.push(`<strong>+${Math.round(dc.distPtsTotal)}</strong> (km przelicz.)`);
      if(dc.hasTimeAct){
        if(dc.hasRun||dc.hasDistAct)parts.push(`<strong>+${dc.timePtsTotal}</strong> czas`);
        else parts.push(`<strong>${dc.timePtsTotal}</strong> pkt (czas)`);
      }
      calc.innerHTML=parts.join(' · ');
      body.appendChild(calc);
    }

    // Buttons
    const addBtns=document.createElement('div');addBtns.className='add-btns';
    const formType=openForm?.dayIdx===idx?openForm.type:null;

    const btnRun=document.createElement('button');btnRun.className='add-btn';
    btnRun.disabled=dayData.runs.length>=2;
    btnRun.textContent=formType==='run'?'✕ Anuluj':dayData.runs.length===0?'+ Bieg':'+ 2. bieg';
    btnRun.onclick=()=>{openForm=formType==='run'?null:{dayIdx:idx,type:'run'};render();};
    addBtns.appendChild(btnRun);

    const btnDist=document.createElement('button');btnDist.className='add-btn blue';
    btnDist.textContent=formType==='dist'?'✕ Anuluj':'+ Spacer/Rower/Pływanie';
    btnDist.onclick=()=>{openForm=formType==='dist'?null:{dayIdx:idx,type:'dist'};render();};
    addBtns.appendChild(btnDist);

    const canAddTime=totalTimeActs<4||dayData.timeActs.filter(a=>a.dur>=20).length>0;
    const btnTime=document.createElement('button');btnTime.className='add-btn green';
    btnTime.disabled=totalTimeActs>=4&&!dayData.timeActs.length;
    btnTime.textContent=formType==='time'?'✕ Anuluj':totalTimeActs>=4?'⚠️ Limit 4/tydz':'+ Siłownia/Joga';
    btnTime.onclick=()=>{openForm=formType==='time'?null:{dayIdx:idx,type:'time'};render();};
    addBtns.appendChild(btnTime);

    body.appendChild(addBtns);
    if(formType==='run')body.appendChild(buildRunForm(idx));
    if(formType==='dist')body.appendChild(buildDistForm(idx));
    if(formType==='time')body.appendChild(buildTimeForm(idx,totalTimeActs));
    card.appendChild(body);
  } else {
    hdr.onclick=()=>{openForm=openForm?.dayIdx===idx?null:{dayIdx:idx,type:'run'};render();};
    if(openForm?.dayIdx===idx){
      const body=document.createElement('div');body.className='day-body';
      const addBtns=document.createElement('div');addBtns.className='add-btns';
      const formType=openForm.type;
      ['run','dist','time'].forEach(t=>{
        const b=document.createElement('button');
        b.className='add-btn'+(t==='dist'?' blue':t==='time'?' green':'');
        b.textContent=formType===t?'✕ Anuluj':t==='run'?'+ Bieg':t==='dist'?'+ Spacer/Rower/Pływanie':'+ Siłownia/Joga';
        b.onclick=()=>{openForm=formType===t?null:{dayIdx:idx,type:t};render();};
        addBtns.appendChild(b);
      });
      body.appendChild(addBtns);
      if(formType==='run')body.appendChild(buildRunForm(idx));
      if(formType==='dist')body.appendChild(buildDistForm(idx));
      if(formType==='time')body.appendChild(buildTimeForm(idx,0));
      card.appendChild(body);
    }
  }
  return card;
}

function buildRunForm(idx){
  const form=document.createElement('div');form.className='inline-form';
  form.innerHTML='<div class="form-title">🏃 Dodaj bieg</div>';
  const row=document.createElement('div');row.className='form-row';
  const grp=document.createElement('div');grp.className='form-group';
  grp.innerHTML='<label>Kilometry (min. 3 km)</label>';
  const inp=document.createElement('input');inp.type='number';inp.min='0';inp.step='0.1';inp.placeholder='np. 5.5';
  inp.style.fontSize='1rem';
  grp.appendChild(inp);row.appendChild(grp);form.appendChild(row);
  const prev=document.createElement('div');prev.className='preview';form.appendChild(prev);
  inp.oninput=()=>{
    const km=parseFloat(inp.value);
    if(isNaN(km)||km<3){prev.textContent=km>0&&km<3?'⚠️ Minimum 3 km':'';return;}
    const d=state.days[idx];
    const existKm=d.runs.filter(r=>r.km>=3).reduce((s,r)=>s+r.km,0);
    const pts=20+(existKm+km)*5;
    prev.innerHTML=`→ <strong style="color:var(--accent)">${Math.round(pts)} pkt</strong> łącznie za biegi dziś`;
  };
  const btns=document.createElement('div');btns.className='form-btns';
  const ok=document.createElement('button');ok.className='btn-confirm';ok.textContent='Dodaj';
  ok.onclick=()=>{const km=parseFloat(inp.value);if(isNaN(km)||km<3){inp.focus();return;}state.days[idx].runs.push({km:Math.round(km*100)/100});openForm=null;save();render();};
  const ca=document.createElement('button');ca.className='btn-cancel';ca.textContent='Anuluj';
  ca.onclick=()=>{openForm=null;render();};
  btns.appendChild(ok);btns.appendChild(ca);form.appendChild(btns);
  setTimeout(()=>inp.focus(),50);
  return form;
}

function buildDistForm(idx){
  const form=document.createElement('div');form.className='inline-form';
  form.innerHTML='<div class="form-title" style="color:var(--blue)">🚴 Dodaj spacer / rower / pływanie</div>';
  const row=document.createElement('div');row.className='form-row';

  const gType=document.createElement('div');gType.className='form-group';gType.innerHTML='<label>Rodzaj</label>';
  const sel=document.createElement('select');
  DIST_TYPES.forEach(t=>{const o=document.createElement('option');o.value=t.v;o.textContent=t.l;sel.appendChild(o);});
  gType.appendChild(sel);

  const gKm=document.createElement('div');gKm.className='form-group';gKm.style.maxWidth='110px';gKm.innerHTML='<label>Kilometry</label>';
  const inp=document.createElement('input');inp.type='number';inp.min='0';inp.step='0.1';inp.placeholder='np. 10';
  inp.style.fontSize='1rem';
  gKm.appendChild(inp);

  row.appendChild(gType);row.appendChild(gKm);form.appendChild(row);
  const prev=document.createElement('div');prev.className='preview';form.appendChild(prev);

  const updatePrev=()=>{
    const km=parseFloat(inp.value);const type=sel.value;
    if(isNaN(km)||km<=0){prev.textContent='';return;}
    if(type==='walk'&&km<3){prev.innerHTML='⚠️ <strong style="color:var(--red)">Spacer liczy się od minimum 3 km</strong>';return;}
    const dt=DIST_TYPES.find(d=>d.v===type);
    const equiv=Math.round(km*dt.mult*10)/10;
    const pts=Math.round(20+equiv*5);
    prev.innerHTML=`${km} km × ${dt.mult} = ${equiv} km bieg. → <strong style="color:var(--blue)">${pts} pkt</strong>`;
  };
  inp.oninput=updatePrev;sel.onchange=updatePrev;

  const btns=document.createElement('div');btns.className='form-btns';
  const ok=document.createElement('button');ok.className='btn-confirm';ok.style.background='var(--blue)';ok.textContent='Dodaj';
  ok.onclick=()=>{
    const km=parseFloat(inp.value);
    if(isNaN(km)||km<=0){inp.focus();return;}
    if(sel.value==='walk'&&km<3){prev.innerHTML='⚠️ <strong style="color:var(--red)">Spacer liczy się od minimum 3 km</strong>';inp.focus();return;}
    state.days[idx].distActs.push({type:sel.value,km:Math.round(km*100)/100});
    openForm=null;save();render();
  };
  const ca=document.createElement('button');ca.className='btn-cancel';ca.textContent='Anuluj';
  ca.onclick=()=>{openForm=null;render();};
  btns.appendChild(ok);btns.appendChild(ca);form.appendChild(btns);
  setTimeout(()=>inp.focus(),50);
  return form;
}

function buildTimeForm(idx,totalTimeActs){
  const form=document.createElement('div');form.className='inline-form';
  form.innerHTML='<div class="form-title" style="color:var(--green)">💪 Dodaj siłownię / jogę / trening</div>';
  if(totalTimeActs>=4){
    form.innerHTML+='<div style="color:var(--yellow);font-size:.82rem;font-weight:500">⚠️ Osiągnięto limit 4 aktywności czasowych tygodniowo.</div>';
    const ca=document.createElement('button');ca.className='btn-cancel';ca.textContent='Zamknij';ca.style.marginTop='.5rem';
    ca.onclick=()=>{openForm=null;render();};form.appendChild(ca);return form;
  }
  const row=document.createElement('div');row.className='form-row';
  const gType=document.createElement('div');gType.className='form-group';gType.innerHTML='<label>Rodzaj</label>';
  const sel=document.createElement('select');
  TIME_TYPES.forEach(t=>{const o=document.createElement('option');o.value=t.v;o.textContent=t.l;sel.appendChild(o);});
  gType.appendChild(sel);
  const gDur=document.createElement('div');gDur.className='form-group';gDur.style.maxWidth='100px';gDur.innerHTML='<label>Minuty</label>';
  const inp=document.createElement('input');inp.type='number';inp.min='1';inp.step='5';inp.placeholder='np. 60';inp.style.fontSize='1rem';
  gDur.appendChild(inp);
  row.appendChild(gType);row.appendChild(gDur);form.appendChild(row);
  const prev=document.createElement('div');prev.className='preview';form.appendChild(prev);
  inp.oninput=()=>{
    const dur=parseInt(inp.value);
    if(isNaN(dur)||dur<20){prev.textContent=dur>0&&dur<20?'⚠️ Minimum 20 minut':'';return;}
    const pts=timePts(dur);
    prev.innerHTML=`${dur} min → <strong style="color:var(--green)">${pts} pkt</strong>`;
  };
  const btns=document.createElement('div');btns.className='form-btns';
  const ok=document.createElement('button');ok.className='btn-confirm';ok.style.background='var(--green)';ok.textContent='Dodaj';
  ok.onclick=()=>{
    const dur=parseInt(inp.value);if(isNaN(dur)||dur<20){inp.focus();return;}
    state.days[idx].timeActs.push({type:sel.value,dur});
    openForm=null;save();render();
  };
  const ca=document.createElement('button');ca.className='btn-cancel';ca.textContent='Anuluj';
  ca.onclick=()=>{openForm=null;render();};
  btns.appendChild(ok);btns.appendChild(ca);form.appendChild(btns);
  setTimeout(()=>inp.focus(),50);
  return form;
}

function buildWeekSummary(w){
  const box=document.createElement('div');box.className='week-summary';
  box.innerHTML=`<div class="week-header">📊 Podsumowanie tygodnia</div>`;
  const body=document.createElement('div');body.className='week-body';

  [{l:`Punkty za aktywności (${w.activeDays} dni)`,v:w.dailyTotal,cls:'pts-r'},
   {l:`Bonus regularność (${w.activeDays} dni aktywnych)`,v:w.regBonus>0?'+'+w.regBonus:'0 — potrzebujesz '+(3-w.activeDays)+' dni',cls:'pts-g'},
   {l:`Bonus biegowy (${w.runDays} dni biegowych)`,v:w.runBonus>0?'+'+w.runBonus:'0',cls:'pts-b'},
  ].forEach(r=>{
    const row=document.createElement('div');row.className='week-row';
    row.innerHTML=`<span>${r.l}</span><span class="${r.cls}">${r.v}</span>`;
    body.appendChild(row);
  });

  if(w.activeDays>0&&w.activeDays<5){
    const next=w.activeDays<3?3:w.activeDays<4?4:5;
    const hint=document.createElement('div');hint.style.cssText='font-size:.75rem;color:var(--muted);margin:.4rem 0';
    hint.textContent=`💡 ${next-w.activeDays} dzień więcej = bonus +${next===3?20:next===4?40:60} pkt`;
    body.appendChild(hint);
  }
  if(w.timeActCount>=4){
    const hint=document.createElement('div');hint.style.cssText='font-size:.75rem;color:var(--yellow);margin:.2rem 0';
    hint.textContent=`⚠️ Limit aktywności czasowych: ${w.timeActCount}/4`;
    body.appendChild(hint);
  }

  const total=document.createElement('div');total.className='week-row total';
  total.innerHTML=`<span>RAZEM</span><span class="pts-total">${w.total} pkt</span>`;
  body.appendChild(total);
  box.appendChild(body);
  return box;
}

render();
</script>
</body>
</html>
